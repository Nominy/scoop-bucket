{
    "version": "0.2.1",
    "description": "A fast, no-nonsense photo viewer",
    "homepage": "https://nominy.github.io/vitreus",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/Nominy/vitreus/releases/download/v0.2.1/vitreus-windows-x64.zip",
            "hash": "0584802460c87de622545a08626f01e70de1004687bfccfc6964d52cd10ccc16"
        }
    },
    "bin": "vitreus.exe",
    "shortcuts": [["vitreus.exe", "Vitreus"]],
    "post_install": [
        "$flags = @('--register', '--path', (Join-Path (Split-Path $dir) 'current\\vitreus.exe'))",
        "if ($global) { $flags += '--machine' }",
        "& \"$dir\\vitreus.exe\" @flags | Out-Null"
    ],
    "pre_uninstall": [
        "$flags = @('--unregister')",
        "if ($global) { $flags += '--machine' }",
        "& \"$dir\\vitreus.exe\" @flags | Out-Null"
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Nominy/vitreus/releases/download/v$version/vitreus-windows-x64.zip"
            }
        },
        "hash": {
            "url": "$baseurl/SHA256SUMS"
        }
    }
}
